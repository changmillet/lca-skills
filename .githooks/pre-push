#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

"$repo_root/scripts/docpact-gate.sh" "$@"

echo "Validating and installing the pinned Skills toolchain."
pnpm check:toolchain
pnpm install --frozen-lockfile

cli_dir="${TIANGONG_LCA_CLI_DIR:-}"
if [ -z "$cli_dir" ] && [ -d "$repo_root/../tiangong-lca-cli" ]; then
  cli_dir="$repo_root/../tiangong-lca-cli"
fi
if [ -n "$cli_dir" ]; then
  echo "Installing and building the local TianGong CLI from its frozen pnpm lockfile."
  (cd "$cli_dir" && pnpm install --frozen-lockfile && pnpm run build)
  export TIANGONG_LCA_CLI_DIR="$cli_dir"
fi

echo "Running local test gate: pnpm prepush:gate"
pnpm prepush:gate
